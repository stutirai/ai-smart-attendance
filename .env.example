# AI-Based Smart Attendance Monitoring System (Group G10)
# Environment Configuration

# Database: Leave empty for high-performance zero-setup local SQLite fallback, 
# or set to your PostgreSQL instance:
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/attendance_db

# Camera source: "0" for laptop webcam, or RTSP URL e.g. "rtsp://admin:pass@192.168.1.10:554/stream1"
CAMERA_SOURCE=0

# System mode: True for accelerated Viva demonstration (5s burst / 15s gap), False for real 50-minute lecture mode
IS_DEMO_MODE=True

# Cosine similarity threshold for ArcFace embeddings in FAISS
RECOGNITION_THRESHOLD=0.55

# Liveness verification
ENABLE_LIVENESS=True
